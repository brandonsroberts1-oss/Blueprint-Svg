# Copy to .env and fill in what you have. Everything is optional.

# Enables "Auto-detect with AI" (photo -> traced elements). https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5)
# CLAUDE_MODEL=claude-opus-5

# Assessor / public-record data (year built, square feet, lot size, beds/baths...).
# RentCast has a free developer tier: https://www.rentcast.io/api
RENTCAST_API_KEY=
# ATTOM Data property API (alternative provider): https://api.developer.attomdata.com
ATTOM_API_KEY=

# Contact email sent in the User-Agent to OpenStreetMap/Nominatim (their usage policy asks for one).
CONTACT_EMAIL=

# Server port (default 5173)
# PORT=5173

# Per-IP limits (per hour). The AI endpoint spends your Anthropic credits.
# AI_TRACES_PER_HOUR=20
# LOOKUPS_PER_HOUR=60
